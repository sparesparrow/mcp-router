{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "declaration": true,
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "composite": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "src/routes.ts",
    "src/server.ts",
    "src/mcpIntegration.ts",
    "src/solidAnalyzerIntegration.ts",
    "src/http/**/*",
    "src/integration/MCPIntegrationService.ts"
  ]
} 